VAGRANT_BASE_BOX = ENV['BASE_BOX'] || "generic/rocky9"

Vagrant.configure("2") do |config|
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # RHEL-based VM
  config.vm.define "rhel_vm" do |rhel|
    rhel.vm.box = VAGRANT_BASE_BOX
    rhel.vm.hostname = "rhel-vm"
    rhel.vm.network "private_network", ip: "192.168.56.11"
  end

  # Single Ansible run for both VMs
  config.vm.provision "ansible" do |ansible|
    ansible.playbook = "playbook.yml"

    # Requirements
    ansible.galaxy_roles_path = File.join(File.dirname(__FILE__), "..", "..", "..", "roles")

    # Increase verbosity
    ansible.verbose = "v"

  end
end

